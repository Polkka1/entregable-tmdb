rules_version = '2';

// Reglas de Mi Cartelera Personal.
// Cada usuario solo puede leer y modificar usuarios/{su uid}/mi_lista, y los datos deben cumplir
// las reglas de negocio también en el servidor (no solo en la app).
service cloud.firestore {
  match /databases/{database}/documents {

    function esDueno(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /usuarios/{uid} {
      allow read, write: if esDueno(uid);

      match /mi_lista/{itemId} {
        allow read, delete: if esDueno(uid);

        // Crear: documento completo y válido, con estado inicial y marcas de tiempo del servidor.
        allow create: if esDueno(uid)
          && esItemValido(request.resource.data, itemId)
          && request.resource.data.estado == 'por_ver'
          && request.resource.data.calificacionPersonal == null
          && request.resource.data.agregadoEn == request.time
          && request.resource.data.actualizadoEn == request.time;

        // Actualizar: solo cambian estado, calificación, comentario y actualizadoEn.
        allow update: if esDueno(uid)
          && esItemValido(request.resource.data, itemId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['estado', 'calificacionPersonal', 'comentario', 'actualizadoEn'])
          && request.resource.data.actualizadoEn == request.time;
      }
    }

    function esItemValido(d, itemId) {
      return d.keys().hasAll(['tmdbId', 'tipo', 'titulo', 'anio', 'posterPath', 'estado',
                              'calificacionPersonal', 'comentario', 'agregadoEn', 'actualizadoEn'])
        && d.keys().hasOnly(['tmdbId', 'tipo', 'titulo', 'anio', 'posterPath', 'estado',
                             'calificacionPersonal', 'comentario', 'agregadoEn', 'actualizadoEn'])
        && d.tipo in ['movie', 'tv']
        && d.tmdbId is int && d.tmdbId > 0
        // El id del documento debe ser tipo_tmdbId (por ejemplo movie_550): impide duplicados.
        && itemId == d.tipo + '_' + string(d.tmdbId)
        && d.titulo is string && d.titulo.size() > 0 && d.titulo.size() <= 200
        && d.anio is string && d.anio.size() <= 4
        && (d.posterPath == null || (d.posterPath is string && d.posterPath.size() <= 200))
        && d.estado in ['por_ver', 'viendo', 'vista']
        && d.comentario is string && d.comentario.size() <= 500
        // Regla de negocio (RF6): solo se califica (1 a 5) si el estado es 'vista'.
        && (d.calificacionPersonal == null
            || (d.estado == 'vista'
                && d.calificacionPersonal is int
                && d.calificacionPersonal >= 1 && d.calificacionPersonal <= 5))
        && d.agregadoEn is timestamp
        && d.actualizadoEn is timestamp;
    }
  }
}
